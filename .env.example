# Copy this file to ".env" and put your own key in it. NEVER commit ".env".
# OpenAI API key (starts with "sk-"): https://platform.openai.com/api-keys
API_KEY=sk-your-openai-key-here

# OpenAI endpoint and vision-capable model
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o

CAMERA_INDEX=0
LANGUAGE=uz            # uz or en
AUTO_INTERVAL=4        # seconds between checks in live mode
# FONT_PATH=C:/Windows/Fonts/segoeui.ttf
